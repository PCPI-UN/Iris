generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectState {
  UNDER_REVIEW
  APPROVED
  REJECTED
  REQUEST_CHANGES
}

enum TypedDocument {
  LOGO
  POSTER
  SUPPORTING_DOCUMENT
}

enum Status {
  ACTIVE
  INACTIVE
}

enum PendingParticipantStatus {
  PENDING // capturado al enviar el proyecto
  INVITED // invitación creada/enviada (cuando apruebas el proyecto)
  JOINED // aceptó e ingresó a ProjectParticipant
}

/**
 * ** PROJECTS, DOCUMENTS & PARTICIPANTS ***
 */
model Project {
  id              Int          @id @default(autoincrement())
  eventId         Int          @map("event_id")
  courseId        Int          @map("course_id")
  name            String       @db.VarChar(255)
  projectCode     String?      @map("project_code") @db.VarChar(50)
  description     String?      @db.Text
  eventNumber     String?      @map("event_number") @db.VarChar(150)
  state           ProjectState @map("state")
  reason          String?      @map("reason") @db.Text
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamp()
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamp()

  documents           ProjectDocument[]
  participants        ProjectParticipant[]
  jurorsAssigned      ProjectAssignment[]
  pendingParticipants PendingProjectParticipant[]
  tutors              ProjectTutor[]
  pendingTutors       PendingProjectTutor[]

  @@unique([eventId, name])
  @@map("projects")
}

model ProjectDocument {
  id        Int      @id @default(autoincrement())
  projectId Int      @map("project_id")
  type      TypedDocument @map("type")
  state     Status   @default(ACTIVE) @map("state")
  url       String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp()
  project   Project  @relation(fields: [projectId], references: [id])

  @@map("project_documents")
}

model ProjectParticipant {
  userId      Int     @map("user_id")
  projectId   Int     @map("project_id")
  studentCode String  @map("student_code") @db.VarChar(20)
  project     Project @relation(fields: [projectId], references: [id])

  @@id([userId, projectId])
  @@map("project_participants")
}

model ProjectAssignment {
  projectId Int @map("project_id")

  // The combination of these three fields is the 'Juror' id, the person who is assigned to evaluate a project
  memberUserId  Int @map("member_user_id")
  memberEventId Int @map("member_event_id")
  memberRoleId  Int @map("member_role_id")

  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamp()
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamp()

  project Project @relation(fields: [projectId], references: [id])

  @@id([projectId, memberUserId, memberEventId, memberRoleId])
  @@map("project_assignments")
}

model PendingProjectParticipant {
  pendingId   Int                      @id @default(autoincrement())
  projectId   Int                      @map("project_id")
  firstName   String                   @map("first_name") @db.VarChar(100)
  lastName    String?                  @map("last_name") @db.VarChar(100)
  email       String                   @db.VarChar(255)
  studentCode String                   @map("student_code") @db.VarChar(20)
  semester    String                   @db.VarChar(50) @default("1")
  career      String                   @db.VarChar(255) @default("N/A")
  status      PendingParticipantStatus @default(PENDING)
  invitedAt   DateTime?                @map("invited_at") @db.Timestamp()
  joinedAt    DateTime?                @map("joined_at") @db.Timestamp()
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamp()
  updatedAt   DateTime                 @updatedAt @map("updated_at") @db.Timestamp()
  project     Project                  @relation(fields: [projectId], references: [id])

  @@unique([projectId, email])
  @@map("pending_project_participants")
  
}

// A tutor is a platform user (auth-service database), so userId has no foreign key
model ProjectTutor {
  projectId Int      @map("project_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp()
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@map("project_tutors")
}

// Tutor typed in by the student who has no account yet; linked when the invitation is accepted
model PendingProjectTutor {
  pendingId Int                      @id @default(autoincrement()) @map("pending_id")
  projectId Int                      @map("project_id")
  firstName String                   @map("first_name") @db.VarChar(100)
  lastName  String?                  @map("last_name") @db.VarChar(100)
  email     String                   @db.VarChar(255)
  status    PendingParticipantStatus @default(PENDING)
  invitedAt DateTime?                @map("invited_at") @db.Timestamp()
  joinedAt  DateTime?                @map("joined_at") @db.Timestamp()
  createdAt DateTime                 @default(now()) @map("created_at") @db.Timestamp()
  updatedAt DateTime                 @updatedAt @map("updated_at") @db.Timestamp()
  project   Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, email])
  @@map("pending_project_tutors")
}
