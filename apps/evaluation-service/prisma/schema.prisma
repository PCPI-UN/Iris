generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model Evaluation {
  id            Int @id @default(autoincrement())
  projectId     Int @map("project_id")

  // The combination of these three fields is the 'Evaluator' id, the person who is evaluating a project
  memberUserId  Int @map("member_user_id")
  memberEventId Int @map("member_event_id")
  memberRoleId  Int @map("member_role_id")

  grade    Float
  comments String?   @db.Text
  date     DateTime  @default(now()) @db.Timestamp() 
  createdAt DateTime @map("created_at") @default(now()) @db.Timestamp()
  updatedAt DateTime @map("updated_at") @updatedAt @db.Timestamp()

  scores EvaluationDetail[]

  @@map("evaluations")
}

model EvaluationDetail {
  evaluationId Int     @map("evaluation_id")
  criterionId  Int     @map("criterion_id")
  score        Float
  // Effective weight of the criterion in the grade when it was evaluated
  weight       Float
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id])
  criterion    Criterion  @relation(fields: [criterionId], references: [id])

  @@id([evaluationId, criterionId])
  @@map("evaluation_detail")
}

/**** CRITERION ****/

model Criterion {
  id          Int             @id @default(autoincrement())
  eventId     Int             @map("event_id")
  name        String             @db.VarChar(100)
  description String?            @db.Text
  // Relative weight inside its component and category (1 by default)
  weight      Float
  active      Boolean
  category    String?            @db.VarChar(100)
  createdAt   DateTime           @map("created_at") @default(now()) @db.Timestamp()
  updatedAt   DateTime           @map("updated_at") @updatedAt @db.Timestamp()
  scores      EvaluationDetail[]
  criterionsCourses CriterionCourse[]
  componentId Int?               @map("component_id")
  component   Component?         @relation(fields: [componentId], references: [id])

  @@map("criterions")
}

/**** CRITERION COURSE JUNCTION TABLE ****/

model CriterionCourse {
  criterionId Int @map("criterion_id")
  courseId    Int @map("course_id")
  
  criterion   Criterion @relation(fields: [criterionId], references: [id])

  @@id([criterionId, courseId])
  @@map("criterions_courses")
}

// New Criterion Component TABLE

model Component {
  id       Int         @id @default(autoincrement())
  name     String
  // Fraction of the grade (0-1); the components of an event add up to 1
  weight   Float
  eventId  Int         @map("event_id")
  criteria Criterion[]
}

/**** TIEBREAK ****/

model TieBreak {
  id            Int      @id @default(autoincrement())
  projectId     Int      @map("project_id")
  eventId       Int      @map("event_id")
  categoryId    Int      @map("category_id")
  tiebreakOrder Int      @map("tiebreak_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp()
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamp()

  @@map("tiebreaks")
}
/**** GRADING SCALES ****/

/// Catalog of grading scales. A juror picks a level (1-4) per criterion; the scale says how many points it is worth.
model GradingScale {
  id              Int                 @id @default(autoincrement())
  name            String              @db.VarChar(100)
  description     String?             @db.Text
  /// System scales are seeded by the migration and read-only
  isSystem        Boolean             @default(false) @map("is_system")
  /// Stable key of a system scale (the legacy evaluation_type it replaces); null for catalog scales
  code            String?             @unique @db.VarChar(32)
  createdByUserId Int?                @map("created_by_user_id")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamp()
  levels          GradingScaleLevel[]
  events          EventGradingScale[]

  @@map("grading_scales")
}

model GradingScaleLevel {
  scaleId Int          @map("scale_id")
  /// 1 to 4, from the lowest to the highest
  level   Int
  label   String       @db.VarChar(50)
  /// Grows from level 1 to 4 without repeating, so stored points map back to one level
  points  Decimal      @db.Decimal(7, 2)
  scale   GradingScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)

  @@id([scaleId, level])
  @@unique([scaleId, points])
  @@map("grading_scale_levels")
}

/// Scale of each event, kept here so evaluation-service can block changes once the event has evaluations
model EventGradingScale {
  eventId    Int          @id @map("event_id")
  scaleId    Int          @map("scale_id")
  assignedAt DateTime     @default(now()) @map("assigned_at") @db.Timestamp()
  scale      GradingScale @relation(fields: [scaleId], references: [id])

  @@index([scaleId])
  @@map("event_grading_scale")
}
