# Production Environment Variables Example
# Copy this file to .env and fill in the values

# ==============================================================================
# SEED DATA
# ==============================================================================
# Passwords for initial admin and test user accounts
SEED_ADMIN_PASSWORD=
SEED_TEST_USER_PASSWORD=

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# Main PostgreSQL superuser password
POSTGRES_PASSWORD=

# Individual database user passwords
# Each microservice has its own database user for security isolation
AUTH_DB_PASSWORD=
EVALUATION_DB_PASSWORD=
EVENT_DB_PASSWORD=
INVITATION_DB_PASSWORD=
PROJECT_DB_PASSWORD=

# NOTE: Database URLs are configured in docker-compose files
# Format: postgresql://<user>:<password>@postgres:5432/<database>

# ==============================================================================
# REDIS CONFIGURATION
# ==============================================================================
REDIS_PASSWORD=

# ==============================================================================
# JWT CONFIGURATION
# ==============================================================================
# JWT keys for access tokens (RS256 requires public/private key pairs)
# Generate with: openssl genrsa -out private.key 2048 && openssl rsa -in private.key -pubout -out public.key
# Then encode in base64 (single line): base64 -w 0 private.key (Linux) or base64 -i private.key | tr -d '\n' (macOS)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# JWT keys for refresh tokens (separate key pair for security)
JWT_REFRESH_PRIVATE_KEY=
JWT_REFRESH_PUBLIC_KEY=

# JWT token expiration times
JWT_ACCESS_TOKEN_EXPIRATION=15m
JWT_REFRESH_TOKEN_EXPIRATION=7d
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# Legacy JWT configuration (if needed for backwards compatibility)
JWT_SECRET=
JWT_EXPIRATION=3600

# ==============================================================================
# SERVICE URLS (Internal - Docker network)
# ==============================================================================
AUTH_SERVICE_URL=auth-service:50051
EVALUATION_SERVICE_URL=evaluation-service:50052
EVENT_SERVICE_URL=event-service:50053
INVITATION_SERVICE_URL=invitation-service:50054
PROJECT_SERVICE_URL=project-service:50055
NOTIFICATION_SERVICE_URL=notification-service:50056

# ==============================================================================
# APPLICATION CONFIGURATION
# ==============================================================================
NODE_ENV=production
GRPC_HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://my-api.test.com
# Cookie Security
# Set to 'true' to allow insecure cookies in production (for local testing over HTTP)
# In actual production with HTTPS, this should be 'false' or unset
# IMPORTANT: Only use 'true' for local testing, NEVER in deployed production
ALLOW_INSECURE_COOKIES=false

## This allows cookies to be sent in cross-origin requests
## Set to 'true' if frontend and backend are on different domains
## Only needed in development or specific deployment scenarios
ALLOW_CROSS_ORIGIN_COOKIES=false

# Password reset token expiry (in minutes)
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=15

# Account setup token expiry (in seconds) - used for new user invitations
# Default: 172800 seconds (2 days)
ACCOUNT_SETUP_TOKEN_EXPIRY_SECONDS=172800

## This allows setting a custom domain for cookies
## Useful if frontend and backend are on different subdomains
COOKIE_DOMAIN=

# ==============================================================================
# EMAIL SERVICE (Azure Communication Services)
# ==============================================================================
ACS_CONNECTION_STRING=
ACS_SENDER_ADDRESS=

# ==============================================================================
# AZURE BLOB STORAGE (Storage para documentos y adjuntos de proyectos)
# ==============================================================================
# En desarrollo local se utiliza una URI dummy sintácticamente válida para permitir
# que el Gateway inicialice el cliente de Azure sin requerir credenciales reales.
# En producción, reemplace con la SAS URL y credenciales de Azure Blob.
AZURE_BLOB_SAS_URL=https://dummy.blob.core.windows.net/dummy?dummy
AZURE_ACCOUNT_NAME=dummy
AZURE_ACCOUNT_KEY=dummy
AZURE_CONTAINER=dummy


# ==============================================================================
# AZURE ENTRA-ID CREDS
# ==============================================================================
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
REDIRECT_URI=
