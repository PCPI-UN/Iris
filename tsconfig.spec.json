{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@app/common": [
        "libs/common/src"
      ],
      "@app/common/*": [
        "libs/common/src/*"
      ],
      "@criterions/*": [
        "apps/evaluation-service/src/modules/criterions/*"
      ],
      "@evaluations/*": [
        "apps/evaluation-service/src/modules/evaluations/*"
      ],
      "@events/*": [
        "apps/event-service/src/modules/events/*"
      ]
    }
  }
}
