erDiagram
    Event ||--o{ StaffEventMember : "participants"
    Event ||--o{ Category : "categories"
    Event ||--o{ EventInscriptionDetail : "eventInscriptionDetails"
    Event ||--o{ EventRecap : "eventRecaps"
    Event ||--o| RankingEvent : "rankingEvent"
    Category ||--o{ AwardCategoryEvent : "categoryAwards"
    AwardCategoryEvent ||--o{ AwardWinnerEvent : "awardWinnerEvents"

    Event {
        Int id PK
        String name
        String description
        String accessCode UK
        Boolean isPubliclyJoinable
        DateTime inscriptionDeadline
        Float inscriptionCost "nullable"
        Boolean evaluationsOpened
        DateTime startDate
        DateTime endDate
        Boolean active
        Int createdByUserId
        String location
        String locationDetails "nullable"
        EvaluationType evaluationType "nullable"
        String inscriptionRequirements "nullable"
        Int minimumTeamSize "nullable"
        String aboutOurAllies "nullable"
        eventType eventType
        String[] collaborators
        String[] organizers
        Float latitude "nullable"
        Float longitude "nullable"
        DateTime createdAt
        DateTime updatedAt
    }

    EventInscriptionDetail {
        Int id PK
        Int eventId FK
        String title
        String description "nullable"
        Int value "nullable"
        Boolean isRequired
        DateTime createdAt
        DateTime updatedAt
    }

    EventRecap {
        Int id PK
        Int eventId FK
        String headline
        String summary "nullable"
        String closingMessage "nullable"
        String galeryUrl "nullable"
        Boolean published
        DateTime createdAt
        DateTime updatedAt
    }

    StaffEventMember {
        Int userId PK
        Int eventId PK, FK
        Int roleId
        Boolean active
        DateTime createdAt
        DateTime updatedAt
    }

    Category {
        Int id PK
        Int eventId FK
        String name
        String description "nullable"
        Boolean active
        DateTime createdAt
        DateTime updatedAt
    }

    AwardCategoryEvent {
        Int id PK
        Int categoryId FK
        String title
        String description "nullable"
        Float value "nullable"
        Int position
        DateTime createdAt
        DateTime updatedAt
    }

    AwardWinnerEvent {
        Int id PK
        Int awardId FK
        Int projectId
        Float grade
        DateTime createdAt
        Int assignedByUserId
    }

    RankingEvent {
        Int id PK
        Int eventId FK, UK
        Boolean visiblePublic
        Int positions
        Boolean gradeVisible
        DateTime createdAt
        DateTime updatedAt
    }
